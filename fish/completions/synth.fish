complete -c synth -f
complete -c synth -l data -rF -d 'path to the todos json file'
complete -c synth -l config -rF -d 'path to the config toml'
complete -c synth -l theme -x -a '(synth --list-themes)' -d 'starting theme'
complete -c synth -l view -x -a 'all today upcoming inbox done ready blocked snoozed' -d 'starting view'
complete -c synth -l count -d 'print the open task count and exit'
complete -c synth -l due-count -d 'print the due or overdue count and exit'
complete -c synth -l list-themes -d 'print built-in theme names'
complete -c synth -l print-config -d 'print the default config template'
complete -c synth -l version -d 'show version'
complete -c synth -s h -l help -d 'show help'
complete -c synth -l tracking -d 'print the tracked task and exit'
complete -c synth -l profile -x -a '(for f in ~/.config/synth/config-*.toml; basename $f .toml | string replace config- ""; end)' -d 'also load config-NAME.toml'
complete -c synth -l habits -d 'print habits done today as done/total and exit'
